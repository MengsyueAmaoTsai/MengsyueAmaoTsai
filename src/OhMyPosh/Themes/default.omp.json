{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "#626c7a",
          "template": "{{.Icon}} "
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "#a66f66",
          "template": "{{ if .SSHSession }}SSH {{ .UserName }}@{{ .HostName }} {{ end }}"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#b0b8c6",
          "options": {
            "style": "folder",
            "folder_icon": " ",
            "home_icon": "~"
          },
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#71947f",
          "options": {
            "branch_icon": " ",
            "branch_identical_icon": "",
            "fetch_status": true
          },
          "template": "{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} S:{{ .Staging.String }}{{ end }}{{ if .Working.Changed }} W:{{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} stash:{{ .StashCount }}{{ end }} "
        },
        {
          "type": "dotnet",
          "style": "plain",
          "foreground": "#8975a5",
          "min_width": 100,
          "timeout": 500,
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": "   {{ .Full }} "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#5f928b",
          "min_width": 100,
          "timeout": 500,
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#a38e65",
          "min_width": 100,
          "timeout": 500,
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": "  {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} "
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "#9b6857",
          "min_width": 100,
          "timeout": 500,
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "cmake",
          "style": "plain",
          "foreground": "#6d849e",
          "min_width": 100,
          "timeout": 500,
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#ac5363",
          "options": {
            "always_enabled": false
          },
          "template": "✖ {{ .Code }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#6d849e",
          "min_width": 80,
          "options": {
            "threshold": 2000,
            "style": "austin",
            "always_enabled": false
          },
          "template": "took {{ .FormattedMs }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#596273",
          "options": {
            "time_format": "15:04:05"
          },
          "template": " {{ .CurrentDate | date .Format }} · {{ dateInZone \"15:04Z\" .CurrentDate \"UTC\" }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#96627d",
          "template": "❯ "
        }
      ]
    }
  ]
}
