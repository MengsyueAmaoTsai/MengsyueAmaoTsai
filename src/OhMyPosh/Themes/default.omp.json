{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "#626c7a",
          "template": "{{.Icon}} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#b0b8c6",
          "options": {
            "style": "folder",
            "folder_icon": " ",
            "home_icon": "~"
          },
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#71947f",
          "options": {
            "branch_icon": " ",
            "fetch_status": true
          },
          "template": "{{ .HEAD }}{{ if .Working.Changed }}*{{ end }} "
        },
        {
          "type": "dotnet",
          "style": "plain",
          "foreground": "#8975a5",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " {{ .Full }} "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#5f928b",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " {{ .Full }} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#a38e65",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} "
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "#9b6857",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " {{ .Full }} "
        },
        {
          "type": "cmake",
          "style": "plain",
          "foreground": "#6d849e",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " {{ .Full }} "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#ac5363",
          "options": {
            "always_enabled": false
          },
          "template": "✖ {{ .Code }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#596273",
          "options": {
            "time_format": "15:04:05"
          },
          "template": " {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#96627d",
          "template": "❯ "
        }
      ]
    }
  ]
}
