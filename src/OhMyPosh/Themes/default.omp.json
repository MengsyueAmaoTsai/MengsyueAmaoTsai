{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "#707d94",
          "template": "{{.Icon}} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#8b93b0",
          "options": {
            "style": "folder",
            "folder_icon": " ",
            "home_icon": "~"
          },
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#7d9a86",
          "options": {
            "branch_icon": " ",
            "fetch_status": true
          },
          "template": "{{ .HEAD }}{{ if .Working.Changed }}*{{ end }} "
        },
        {
          "type": "dotnet",
          "style": "plain",
          "foreground": "#9b84ad",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " {{ .Full }} "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#6f9a93",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " {{ .Full }} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#b0996a",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} "
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "#ad7d63",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " {{ .Full }} "
        },
        {
          "type": "cmake",
          "style": "plain",
          "foreground": "#7e93ab",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " {{ .Full }} "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#a8505f",
          "options": {
            "always_enabled": false
          },
          "template": "✖ {{ .Code }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#6c7488",
          "options": {
            "time_format": "15:04:05"
          },
          "template": " {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#9a6c82",
          "template": "❯ "
        }
      ]
    }
  ]
}